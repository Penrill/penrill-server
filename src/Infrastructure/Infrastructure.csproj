<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Penrill.Infrastructure</RootNamespace>
    <AssemblyName>Penrill.Infrastructure</AssemblyName>
    <IsPackable>true</IsPackable>
    <Description>Penrill persistence and identity: the EF Core model, ASP.NET Core Identity accounts, bearer credentials and a file asset store. Each host picks the database provider.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
  </ItemGroup>

</Project>
