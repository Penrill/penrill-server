@page "/reset/{token?}"
@model ResetModel
@{ ViewData["Title"] = "New password"; }
<div class="narrow">
    @if (Model.For is null)
    {
        <h1>This link does not work</h1>
        <p class="lead">It has expired or was already used. Ask for a new one.</p>
    }
    else
    {
        <h1>New password for @Model.For</h1>
        <p class="lead">Devices connected before will need to be connected again.</p>
        <form method="post" class="stack">
            <input type="text" name="username" value="@Model.For" autocomplete="username" hidden>
            <label>New password
                <input asp-for="Password" type="password" autocomplete="new-password" required minlength="10" maxlength="256" autofocus>
            </label>
            @if (Model.Error is { } error) { <p class="error" role="alert">@error</p> }
            <button class="primary" type="submit">Set password</button>
        </form>
    }
</div>
