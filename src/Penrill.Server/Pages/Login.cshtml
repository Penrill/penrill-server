@page "/login"
@model LoginModel
@{ ViewData["Title"] = "Sign in"; }
<div class="narrow">
    <h1>Sign in</h1>
    <p class="lead">Use your account on this Penrill server.</p>
    <form method="post" class="stack">
        <input type="hidden" asp-for="Return">
        <label>Username
            <input asp-for="Name" autocomplete="username" required autocapitalize="none" spellcheck="false" autofocus>
        </label>
        <label>Password
            <input asp-for="Password" type="password" autocomplete="current-password" required>
        </label>
        @if (Model.Error is { } error) { <p class="error" role="alert">@error</p> }
        <button class="primary" type="submit">Sign in</button>
        <p class="hint">No account? Ask the person who runs this server for an invite link. Forgot your password? They can send you a reset link.</p>
    </form>
</div>
