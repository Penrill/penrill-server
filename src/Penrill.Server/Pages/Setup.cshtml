@page "/setup"
@model SetupModel
@{ ViewData["Title"] = "Set up"; }
<div class="narrow">
    <h1>Set up your Penrill server</h1>

    @* Without the setup link there is nothing to type here: explain where the link comes from instead of
       showing a form that can only fail. The link's token arrives in the URL fragment, so the script below
       swaps this for the form when it is there. *@
    <section id="need-link" class="stack-gap" hidden="@(Model.Token is not null)">
        @if (Model.Expired) { <p class="error" role="alert">That setup link has expired or was already used. Get a new one below.</p> }
        <p class="lead">Open this page through the setup link from your server. Only someone with that link can become the server's owner, so nobody else on your network can take it over.</p>
        <div class="card stack-gap">
            <p><strong>On the server, run:</strong></p>
            <div class="row">
                <pre class="command" id="setup-command">sudo penrill-server setup</pre>
                <button type="button" id="copy-command">Copy</button>
            </div>
            <p class="muted">It prints a link and a QR code. Open the link in this browser, or scan the code with your phone.</p>
        </div>
        <p class="hint">Just installed the package? The same link was printed at the end of the installation.</p>
    </section>

    <form method="post" class="stack" id="setup-form" hidden="@(Model.Token is null)">
        <p class="lead">Create the owner account. Others join later through invite links you create.</p>
        <input type="hidden" id="token" asp-for="Token">
        <label>Username
            <input asp-for="Name" autocomplete="username" required pattern="[a-z0-9_\-]{3,32}" autocapitalize="none" spellcheck="false">
            <small>Lowercase letters, digits, - and _</small>
        </label>
        <label>Password
            <input asp-for="Password" type="password" autocomplete="new-password" required minlength="10" maxlength="256">
            <small>At least 10 characters</small>
        </label>
        <label>Server name
            <input asp-for="ServerName" required maxlength="64">
            <small>Shown in Penrill when you connect</small>
        </label>
        @if (Model.Error is { } error) { <p class="error" role="alert">@error</p> }
        <button class="primary" type="submit">Create owner account</button>
    </form>
</div>
<script>
    // The token travels in the fragment so it stays out of logs. Opening the link while /setup is
    // already open only changes the fragment, so listen for that too.
    (() => {
        const field = document.getElementById('token')
        const read = () => {
            const key = new URLSearchParams(location.hash.slice(1)).get('k')
            if (key) {
                field.value = key
                history.replaceState(null, '', location.pathname)
            }
            document.getElementById('need-link').hidden = !!field.value
            document.getElementById('setup-form').hidden = !field.value
        }
        addEventListener('hashchange', read)
        read()
        const copy = document.getElementById('copy-command')
        copy.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(document.getElementById('setup-command').textContent)
                copy.textContent = 'Copied'
                setTimeout(() => (copy.textContent = 'Copy'), 1500)
            } catch {
                getSelection().selectAllChildren(document.getElementById('setup-command'))
            }
        })
    })()
</script>
