@page "/admin"
@model Penrill.Server.Pages.Admin.IndexModel
@{ ViewData["Title"] = "People"; }
<h1>Administration</h1>
<p class="lead">People who can use this server.</p>
<partial name="_AdminTabs" />

@if (Model.LinkUrl is { } url)
{
    <section class="card connect" style="margin-bottom:32px">
        <div>
            <p style="font-weight:600">@Model.LinkTitle</p>
            <input readonly value="@url" onclick="this.select()" aria-label="Link">
            <p class="hint" style="margin-top:8px">Shown once. Anyone with the link can use it.</p>
        </div>
        <partial name="_Qr" model="url" />
    </section>
}

<h2 style="margin-top:0">Invite someone</h2>
<form method="post" asp-page-handler="Invite" class="row">
    <select asp-for="InviteRole" aria-label="Role">
        <option value="Member">Member</option>
        <option value="Admin">Admin</option>
    </select>
    <select asp-for="InviteUses" aria-label="Uses">
        <option value="1">Single use</option>
        <option value="5">5 people</option>
        <option value="25">25 people</option>
    </select>
    <select asp-for="InviteDays" aria-label="Valid for">
        <option value="1">1 day</option>
        <option value="7">7 days</option>
        <option value="30">30 days</option>
    </select>
    <button class="primary" type="submit">Create invite link</button>
</form>

@if (Model.Invites.Count > 0)
{
    <h2>Open invites</h2>
    <div class="table"><table>
        <thead><tr><th>Role</th><th>Uses left</th><th>Expires</th><th>By</th><th></th></tr></thead>
        <tbody>
        @foreach (var invite in Model.Invites)
        {
            <tr>
                <td>@invite.Subject.ToLowerInvariant()</td>
                <td>@invite.UsesLeft</td>
                <td>@(invite.Expires?.ToLocalTime().ToString("g") ?? "never")</td>
                <td>@invite.CreatedBy</td>
                <td class="actions"><form method="post" asp-page-handler="DeleteInvite"><input type="hidden" name="id" value="@invite.Id"><button class="danger" type="submit">Delete</button></form></td>
            </tr>
        }
        </tbody>
    </table></div>
}

<h2>Accounts</h2>
<div class="table"><table>
    <thead><tr><th>User</th><th>Role</th><th></th></tr></thead>
    <tbody>
    @foreach (var user in Model.Users)
    {
        <tr>
            <td>@user.Name @if (user.Disabled) { <span class="badge">disabled</span> }</td>
            <td>
                @if (user.Role == Role.Owner)
                {
                    <span class="badge">owner</span>
                }
                else
                {
                    <form method="post" asp-page-handler="Role">
                        <input type="hidden" name="user" value="@user.Name">
                        <select name="role" onchange="this.form.submit()" aria-label="Role of @user.Name">
                            <option value="Member" selected="@(user.Role == Role.Member)">member</option>
                            <option value="Admin" selected="@(user.Role == Role.Admin)">admin</option>
                        </select>
                    </form>
                }
            </td>
            <td class="actions">
                <form method="post" asp-page-handler="Reset"><input type="hidden" name="user" value="@user.Name"><button type="submit">Reset password</button></form>
                @if (user.Role != Role.Owner)
                {
                    <form method="post" asp-page-handler="Disable">
                        <input type="hidden" name="user" value="@user.Name">
                        <input type="hidden" name="disabled" value="@(user.Disabled ? "false" : "true")">
                        <button class="@(user.Disabled ? "" : "danger")" type="submit">@(user.Disabled ? "Enable" : "Disable")</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table></div>
