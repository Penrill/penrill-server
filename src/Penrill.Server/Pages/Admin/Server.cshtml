@page "/admin/server"
@model Penrill.Server.Pages.Admin.ServerModel
@{ ViewData["Title"] = "Server"; }
<h1>Administration</h1>
<p class="lead">This server and its data.</p>
<partial name="_AdminTabs" />

<dl>
    <dt>Address</dt><dd>@Model.Origin</dd>
    <dt>Reachable</dt><dd>@(Model.Address.Mode == AddressMode.Lan ? "In this network" : "On this machine only")</dd>
    @if (Model.Address.ShortPin is { } pin)
    {
        <dt>Certificate</dt><dd>Own certificate, fingerprint @pin</dd>
    }
    <dt>Version</dt><dd>@Model.Version</dd>
    <dt>Accounts</dt><dd>@Model.Counts.Users</dd>
    <dt>Boards</dt><dd>@Model.Counts.Boards</dd>
    <dt>Devices</dt><dd>@Model.Counts.Devices</dd>
</dl>

<h2>Name</h2>
<form method="post" asp-page-handler="Rename" class="row">
    <input asp-for="Name" required maxlength="64" aria-label="Server name">
    <button type="submit">Save</button>
</form>
@if (Model.Error is { } error) { <p class="error" role="alert" style="margin-top:8px">@error</p> }

<h2>Backup</h2>
<p class="muted">One archive with every board, image and account. Keep it somewhere else than this server.</p>
<a class="button" href="/admin/server?handler=Backup">Download backup</a>
