@page "/admin/boards"
@model Penrill.Server.Pages.Admin.BoardsModel
@{ ViewData["Title"] = "Boards"; }
<h1>Administration</h1>
<p class="lead">Boards without an owner, from server versions before accounts.</p>
<partial name="_AdminTabs" />
@if (Model.Orphans.Count == 0)
{
    <p class="muted">Every board has an owner.</p>
}
else
{
    <div class="table"><table>
        <thead><tr><th>Board</th><th>Last change</th><th>Give to</th></tr></thead>
        <tbody>
        @foreach (var board in Model.Orphans)
        {
            <tr>
                <td>@board.Title</td>
                <td>@board.Updated.ToLocalTime().ToString("d")</td>
                <td>
                    <form method="post" asp-page-handler="Assign" class="row">
                        <input type="hidden" name="board" value="@board.Id">
                        <select name="user" aria-label="New owner of @board.Title">
                            @foreach (var user in Model.Users) { <option value="@user.Name">@user.Name</option> }
                        </select>
                        <button type="submit">Assign</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table></div>
}
