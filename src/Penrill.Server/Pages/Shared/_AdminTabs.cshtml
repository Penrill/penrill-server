@{
    var path = Context.Request.Path.Value ?? "";
    string Current(string target) => string.Equals(path.TrimEnd('/'), target, StringComparison.OrdinalIgnoreCase) ? "current" : "";
}
<nav class="tabs">
    <a class="@Current("/admin")" href="/admin">People</a>
    <a class="@Current("/admin/devices")" href="/admin/devices">Devices</a>
    <a class="@Current("/admin/boards")" href="/admin/boards">Boards</a>
    <a class="@Current("/admin/server")" href="/admin/server">Server</a>
</nav>
