@page "/account"
@model AccountModel
@{ ViewData["Title"] = "Account"; }
<h1>@User.Identity!.Name</h1>
<p class="lead">Your account on this server.</p>

<h2>Connected devices</h2>
@if (Model.Devices.Count == 0)
{
    <p class="muted">None yet. <a href="/">Connect Penrill</a>.</p>
}
else
{
    <div class="table"><table>
        <thead><tr><th>Device</th><th>Connected</th><th>Last used</th><th></th></tr></thead>
        <tbody>
        @foreach (var device in Model.Devices)
        {
            <tr>
                <td>@device.Name</td>
                <td>@device.Created.ToLocalTime().ToString("d")</td>
                <td>@(device.LastUsed?.ToLocalTime().ToString("d") ?? "never")</td>
                <td class="actions"><form method="post" asp-page-handler="Revoke"><input type="hidden" name="id" value="@device.Id"><button class="danger" type="submit">Disconnect</button></form></td>
            </tr>
        }
        </tbody>
    </table></div>
}

<h2>Password</h2>
<form method="post" asp-page-handler="Password" class="stack narrow" style="margin-inline:0">
    <input type="text" name="username" value="@User.Identity!.Name" autocomplete="username" hidden>
    <label>Current password <input asp-for="Current" type="password" autocomplete="current-password" required></label>
    <label>New password <input asp-for="Next" type="password" autocomplete="new-password" required minlength="10" maxlength="256"></label>
    @if (Model.Error is { } error) { <p class="error" role="alert">@error</p> }
    <div><button type="submit">Change password</button></div>
</form>
