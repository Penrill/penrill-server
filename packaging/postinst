#!/bin/sh
set -e
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    if [ -z "$2" ]; then
        systemctl enable --now penrill-server.service
    else
        systemctl try-restart penrill-server.service
    fi
    systemctl try-reload-or-restart avahi-daemon.service 2>/dev/null || true
    # Wait for the admin socket to come up.
    i=0
    while [ ! -S /run/penrill-server/admin.sock ] && [ $i -lt 30 ]; do sleep 0.5; i=$((i + 1)); done
    if [ -z "${PENRILL_INSTALLER:-}" ]; then
        if /usr/bin/penrill-server status 2>/dev/null | grep -q "none yet"; then
            /usr/bin/penrill-server setup || true
        fi
        printf '\n  Run "sudo penrill-server" anytime to open the interactive configurator & control panel.\n\n'
    fi
fi
