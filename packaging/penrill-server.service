[Unit]
Description=Penrill board synchronization server
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=penrill-server
RuntimeDirectory=penrill-server
WorkingDirectory=/usr/lib/penrill-server
Environment=PENRILL_DATA_DIR=/var/lib/penrill-server
Environment=PENRILL_ADDRESS_MODE=lan
Environment=PENRILL_ADMIN_SOCKET=/run/penrill-server/admin.sock
ExecStart=/usr/lib/penrill-server/Penrill.Server --serve
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
